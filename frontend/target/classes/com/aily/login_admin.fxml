<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane
        prefHeight="Infinity"
        prefWidth="Infinity"
        styleClass="root-bg"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.aily.controller.LoginAdminController">

    <HBox
            alignment="CENTER"
            prefHeight="Infinity"
            prefWidth="Infinity"
            spacing="0"
            styleClass="root-bg">

        <VBox
                alignment="CENTER_LEFT"
                maxWidth="Infinity"
                prefWidth="600.0"
                spacing="15.0"
                styleClass="login-left-panel"
                HBox.hgrow="ALWAYS">
            <padding>
                <Insets left="80.0" right="40.0" />
            </padding>

            <Label styleClass="logo-giant-left" text="AILY">
                <font>
                    <Font name="System Bold" size="48.0" />
                </font>
            </Label>

            <Label styleClass="login-welcome-title" text="Admin Dashboard" />

            <Label
                    styleClass="login-welcome-desc"
                    text="Kelola toko dan pantau performa bisnis Anda dengan mudah dalam satu dashboard terintegrasi."
                    wrapText="true" />

            <Region styleClass="login-divider-teal" />

            <HBox spacing="10.0">
                <Label styleClass="text-teal" text="✦" />
                <Label styleClass="login-feature-text" text="Manajemen produk &amp; stok efisien" />
            </HBox>

            <HBox spacing="10.0">
                <Label styleClass="text-teal" text="✦" />
                <Label styleClass="login-feature-text" text="Analisis penjualan real-time" />
            </HBox>
        </VBox>

        <VBox
                alignment="CENTER_LEFT"
                minWidth="100.0"
                prefWidth="1200"
                spacing="10.0"
                styleClass="login-right-panel">
            <padding>
                <Insets left="50.0" right="50.0" />
            </padding>

            <Label styleClass="login-form-title" text="Admin Login" />
            <Label styleClass="subheading-gray" text="Masuk ke akun Seller / Administrator" />

            <VBox spacing="8.0">
                <Label styleClass="field-label" text="Username Admin" />
                <TextField
                        fx:id="usernameField"
                        promptText="Masukkan username admin"
                        styleClass="input-pill"
                        prefHeight="40.0" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="field-label" text="Password" />
                <PasswordField
                        fx:id="passwordField"
                        promptText="Password"
                        styleClass="input-pill"
                        prefHeight="40.0" />
            </VBox>

            <HBox alignment="CENTER_RIGHT">
                <Hyperlink
                        onAction="#handleForgotPassword"
                        styleClass="link-gray"
                        text="Lupa Password Admin?" />
            </HBox>

            <Label
                    fx:id="errorLabel"
                    styleClass="error-label"
                    wrapText="true"
                    text="" />

            <Button
                    fx:id="loginButton"
                    maxWidth="Infinity"
                    onAction="#handleLogin"
                    prefHeight="45.0"
                    styleClass="btn-teal"
                    text="Masuk Dashboard" />

            <HBox alignment="CENTER" spacing="10.0">
                <Label styleClass="text-gray" text="Belum punya akun?" />
                <Hyperlink onAction="#goToRegister" styleClass="link-teal" text="Daftar Seller" />
                <Label styleClass="text-gray" text="|" />
                <Hyperlink onAction="#goBack" styleClass="link-back" text="← Kembali" />
            </HBox>

        </VBox>
    </HBox>
</StackPane>