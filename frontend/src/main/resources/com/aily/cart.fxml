<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>

<BorderPane prefHeight="1080" prefWidth="1920" styleClass="root-bg" xmlns="http://javafx.com/javafx/25" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aily.controller.CartController">

    <!-- TOP: Header -->
    <top>
        <HBox alignment="CENTER_LEFT" spacing="16" styleClass="page-header">
            <Button onAction="#goBack" styleClass="back-btn" text="←" />
            <Label styleClass="logo-text-sm" text="AILY" />
            <Label styleClass="page-title" text="Keranjang Belanja" HBox.hgrow="ALWAYS" />
            <Label fx:id="itemCountLabel" styleClass="item-count-badge" text="0 item" />
        </HBox>
    </top>

    <!-- CENTER: Cart items -->
    <center>
        <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll">
            <content>
                <StackPane>
                    <!-- Empty state -->
                    <VBox fx:id="emptyState" alignment="CENTER" spacing="16" visible="true">
                        <Label style="-fx-font-size: 48px;" text="🛒" />
                        <Label styleClass="empty-state-label" text="Keranjang kamu masih kosong" />
                        <Button onAction="#goBack" prefWidth="160" styleClass="btn-outline" text="Mulai belanja" />
                        <!-- AILY watermark -->
                        <Label opacity="0.12" styleClass="watermark" text="AILY" />
                  <StackPane.margin>
                     <Insets top="250.0" />
                  </StackPane.margin>
                    </VBox>

                    <!-- Item list -->
                    <VBox fx:id="cartItemsBox" spacing="12" visible="false">
                        <padding><Insets bottom="20" left="24" right="24" top="20" /></padding>
                    </VBox>
                </StackPane>
            </content>
        </ScrollPane>
    </center>

    <!-- RIGHT: Summary panel -->
    <right>
        <VBox spacing="14" styleClass="summary-panel">
            <Label styleClass="summary-title" text="Ringkasan Pesanan" />
            <Region prefHeight="1" styleClass="summary-divider" />

            <HBox alignment="CENTER_LEFT">
                <Label styleClass="summary-row-label" text="Subtotal" HBox.hgrow="ALWAYS" />
                <Label fx:id="subtotalLabel" styleClass="summary-row-value" text="Rp 0" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="summary-row-label" text="Ongkos Kirim" HBox.hgrow="ALWAYS" />
                <Label fx:id="ongkirLabel" styleClass="summary-row-value" text="Rp 0" />
            </HBox>
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="summary-row-label" text="Diskon" HBox.hgrow="ALWAYS" />
                <Label fx:id="diskonLabel" styleClass="summary-row-value" text="- Rp 0" />
            </HBox>

            <Region prefHeight="1" styleClass="summary-divider" />

            <HBox alignment="CENTER_LEFT">
                <Label styleClass="summary-total-label" text="Total" HBox.hgrow="ALWAYS" />
                <Label fx:id="totalLabel" styleClass="summary-total-value" text="Rp 0" />
            </HBox>

            <Region VBox.vgrow="ALWAYS" />

            <Button maxWidth="Infinity" onAction="#handleCheckout" prefHeight="44" styleClass="btn-teal" text="Buat Pesanan" />
            <Button maxWidth="Infinity" onAction="#goBack" prefHeight="44" styleClass="btn-outline" text="← Lanjut Belanja" />

            <Label alignment="CENTER" maxWidth="260" styleClass="text-muted" text="Pesanan dapat dibatalkan sebelum masa pengantaran dimulai" wrapText="true" />
        </VBox>
    </right>

</BorderPane>
