<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Hyperlink?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<StackPane
        prefHeight="Infinity"
        prefWidth="Infinity"
        styleClass="root-bg"
        xmlns="http://javafx.com/javafx/26"
        xmlns:fx="http://javafx.com/fxml/1"
        fx:controller="com.aily.controller.RegisterController">

    <HBox
            alignment="CENTER"
            prefHeight="Infinity"
            prefWidth="Infinity"
            spacing="0"
            styleClass="root-bg">

        <VBox
                alignment="CENTER_LEFT"
                maxWidth="Infinity"
                prefWidth="600.0"
                spacing="15.0"
                styleClass="login-left-panel"
                HBox.hgrow="ALWAYS">
            <padding>
                <Insets left="80.0" right="40.0" />
            </padding>

            <Label styleClass="logo-giant-left" text="AILY">
                <font>
                    <Font name="System Bold" size="48.0" />
                </font>
            </Label>

            <Label styleClass="login-welcome-title" text="Gabung Sekarang!" />

            <Label
                    styleClass="login-welcome-desc"
                    text="Buat akunmu sekarang dan nikmati pengalaman berbelanja yang lebih personal dan menguntungkan."
                    wrapText="true" />

            <Region styleClass="login-divider-teal" />

            <HBox spacing="10.0">
                <Label styleClass="text-teal" text="✦" />
                <Label styleClass="login-feature-text" text="Akses promo eksklusif member" />
            </HBox>

            <HBox spacing="10.0">
                <Label styleClass="text-teal" text="✦" />
                <Label styleClass="login-feature-text" text="Simpan alamat untuk checkout cepat" />
            </HBox>
        </VBox>

        <VBox
                alignment="CENTER_LEFT"
                minWidth="100.0"
                prefWidth="1200"
                spacing="10.0"
                styleClass="login-right-panel">
            <padding>
                <Insets left="50.0" right="50.0" />
            </padding>

            <Label styleClass="login-form-title" text="Register" />
            <Label styleClass="subheading-gray" text="Buat akun baru untuk mulai belanja" />

            <VBox spacing="8.0">
                <Label styleClass="field-label" text="Username" />
                <TextField
                        fx:id="usernameField"
                        promptText="Pilih username unik"
                        styleClass="input-pill"
                        prefHeight="40.0" />
            </VBox>

            <VBox spacing="8.0">
                <Label styleClass="field-label" text="Password" />
                <PasswordField
                        fx:id="passwordField"
                        promptText="Masukan Password"
                        styleClass="input-pill"
                        prefHeight="40.0" />
            </VBox>

            <Label
                    fx:id="errorLabel"
                    styleClass="error-label"
                    wrapText="true"
                    text="" />

            <Button
                    fx:id="registerButton"
                    maxWidth="Infinity"
                    onAction="#handleRegister"
                    prefHeight="45.0"
                    styleClass="btn-teal"
                    text="Daftar Akun" />

            <HBox alignment="CENTER" spacing="10.0">
                <VBox.margin>
                    <Insets top="10.0" />
                </VBox.margin>
                <Label styleClass="text-gray" text="Sudah punya akun?" />
                <Hyperlink onAction="#goBack" styleClass="link-teal" text="Login" />
                <Label styleClass="text-gray" text="|" />
                <Hyperlink onAction="#goBack" styleClass="link-back" text="← Kembali" />
            </HBox>

        </VBox>
    </HBox>
</StackPane>