<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.*?>
<?import javafx.scene.layout.*?>

<HBox prefHeight="1080" prefWidth="1920" styleClass="root-bg" xmlns="http://javafx.com/javafx/17.0.12" xmlns:fx="http://javafx.com/fxml/1" fx:controller="com.aily.controller.AdminProductsController">

    <!-- Sidebar -->
    <VBox minWidth="260" prefWidth="260" styleClass="sidebar">
        <padding><Insets bottom="20" left="20" right="20" top="20" /></padding>
        <HBox alignment="CENTER_LEFT" spacing="10">
            <Label styleClass="logo-text" text="AILY" />
            <Label styleClass="admin-badge" text="ADMIN" />
        </HBox>
        <Region prefHeight="1" styleClass="sidebar-divider"><VBox.margin><Insets bottom="16" top="16" /></VBox.margin></Region>
        <Label styleClass="sidebar-section-label" text="Menu Utama" />
        <Button onAction="#goOverview" styleClass="menu-item-btn" text="📊  Overview" />
        <Button onAction="#goProducts" styleClass="menu-item-btn-active" text="📦  Kelola Produk"><VBox.margin><Insets top="4" /></VBox.margin></Button>
        <Button onAction="#goStoreInfo" styleClass="menu-item-btn" text="🏪  Info Toko"><VBox.margin><Insets top="4" /></VBox.margin></Button>
        <Button onAction="#goTransactions" styleClass="menu-item-btn" text="💳  Transaksi"><VBox.margin><Insets top="4" /></VBox.margin></Button>
        <Button onAction="#goChatHistory" styleClass="menu-item-btn" text="💬  Riwayat Chat"><VBox.margin><Insets top="4" /></VBox.margin></Button>
        <Region VBox.vgrow="ALWAYS" />
        <Button onAction="#handleLogout" styleClass="logout-btn" text="[← Keluar" />
    </VBox>

    <!-- Content -->
    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="chat-scroll" HBox.hgrow="ALWAYS">
        <content>
            <VBox spacing="24" styleClass="admin-content">
                <Label styleClass="page-title" text="Kelola Produk" />

                <!-- Form card -->
                <HBox spacing="20" alignment="TOP_LEFT">
                    <VBox spacing="16" styleClass="form-card" HBox.hgrow="ALWAYS">
                        <Label styleClass="form-section-title" text="+ Tambah/Edit Produk" />
                        <Region prefHeight="1" styleClass="form-divider" />

                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="field-label" text="Nama Produk" />
                                <TextField fx:id="namaProdukField" promptText="cth: Laptop Asus" styleClass="input-dark-sm" />
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="field-label" text="Gender" />
                                <TextField fx:id="genderProdukField" promptText="L/P" styleClass="input-dark-sm" />
                            </VBox>
                        </HBox>
                        <HBox spacing="16">
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="field-label" text="Harga (Rp)" />
                                <TextField fx:id="hargaField" promptText="0" styleClass="input-dark-sm" />
                            </VBox>
                            <VBox spacing="6" HBox.hgrow="ALWAYS">
                                <Label styleClass="field-label" text="Stok" />
                                <TextField fx:id="stokField" promptText="0" styleClass="input-dark-sm" />
                            </VBox>
                        </HBox>
                        <VBox spacing="6">
                            <Label styleClass="field-label" text="Deskripsi" />
                            <TextArea fx:id="deskripsiField" prefHeight="90" promptText="Deskripsi Produk" styleClass="textarea-dark" wrapText="true" />
                        </VBox>

                        <VBox spacing="6">
                            <Label styleClass="field-label" text="Gambar Produk" />
                            <HBox alignment="CENTER_LEFT" spacing="10">
                                <Button onAction="#handleChooseImage" styleClass="btn-gray" text="Pilih Gambar" />
                                <Label fx:id="imageNameLabel" styleClass="text-gray" text="Belum ada gambar" />
                            </HBox>
                        </VBox>

                        <Button fx:id="saveButton" onAction="#handleSave" prefWidth="180" styleClass="btn-teal" text="Simpan Produk" />
                    </VBox>

                    <VBox alignment="TOP_CENTER" spacing="8" styleClass="form-card" prefWidth="250" minWidth="250">
                        <Label styleClass="form-section-title" text="Preview Gambar" />
                        <Region prefHeight="1" styleClass="form-divider" />
                        <ImageView fx:id="productPreview" fitHeight="200.0" fitWidth="200.0" pickOnBounds="true" preserveRatio="true">
                            <VBox.margin><Insets top="10" /></VBox.margin>
                        </ImageView>
                    </VBox>
                </HBox>

                <!-- Product list table -->
                <VBox spacing="0" styleClass="table-card">
                    <HBox alignment="CENTER_LEFT">
                        <Label styleClass="form-section-title" text="Daftar Produk" HBox.hgrow="ALWAYS" />
                        <Label fx:id="produkCountLabel" styleClass="text-gray" text="0 produk">
                     <padding>
                        <Insets left="10.0" />
                     </padding></Label>
                    </HBox>
                    <Region prefHeight="1" styleClass="form-divider"><VBox.margin><Insets bottom="8" top="12" /></VBox.margin></Region>

                    <TextField fx:id="searchField" promptText="🔍 Cari produk berdasarkan nama, kode, atau ID..." styleClass="input-dark-sm">
                        <VBox.margin><Insets bottom="10" /></VBox.margin>
                    </TextField>

                    <HBox styleClass="table-header-row">
                        <Label prefWidth="60" styleClass="table-col-label" text="ID" />
                        <Label prefWidth="200" styleClass="table-col-label" text="NAMA" />
                        <Label prefWidth="160" styleClass="table-col-label" text="HARGA" />
                        <Label prefWidth="140" styleClass="table-col-label" text="STOK" />
                  <Label prefWidth="70" styleClass="table-col-label" text="GENDER" />
                        <Label prefWidth="170" styleClass="table-col-label" text="AKSI" />
                    </HBox>

                    <ScrollPane fitToWidth="true" hbarPolicy="NEVER" vbarPolicy="AS_NEEDED" maxHeight="310" styleClass="table-scroll">
                        <VBox fx:id="productRowsBox" />
                    </ScrollPane>
                </VBox>
            </VBox>
        </content>
    </ScrollPane>
</HBox>
